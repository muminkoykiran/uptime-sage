# ============================================================
# Uptime Resilience Agent — Ortam Degiskenleri
# cp .env.example .env  →  doldurup kaydet
# .env dosyasini ASLA git'e ekleme!
# ============================================================

# ---- ZORUNLU ----

# Uptime Kuma instance URL
UPTIME_KUMA_URL=https://uptime.ornekdomain.com

# Telegram Bot Token (@BotFather'dan al)
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Telegram Chat ID (kullanici, grup veya kanal)
# Kullanici ID: @userinfobot'a mesaj at
# Grup ID: Gruba @getidsbot ekle, grup ID'si negatif olur
TELEGRAM_CHAT_ID=123456789

# ---- UPTIME KUMA AUTH (onerilen) ----

# JWT Token — tum monitorlere erisim ve aksiyon alma icin (ONERILEN)
# Nasil alinir: node scripts/get-jwt-token.js <username> <password>
# Token expire olmuyor, bir kez almaniz yeterli.
UPTIME_KUMA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT almak icin kullanici bilgileri (get-jwt-token.js scripti icin)
# Token aldiktan sonra bu satirlari silebilirsiniz
# UPTIME_KUMA_USERNAME=admin
# UPTIME_KUMA_PASSWORD=sifreniz

# ---- OPSIYONEL ----

# Timezone (default: UTC)
# Listesi: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TIMEZONE=Europe/Istanbul

# Tekrar alert aralik suresi — saat cinsinden (default: 4)
# DOWN monitor icin kac saatte bir alert gonderilsin?
# ALERT_REPEAT_HOURS=4

# Severity bazli farkli Telegram kanalina eskalasyon (zorunlu degil)
# TELEGRAM_CRITICAL_CHAT_ID=-100123456789
# TELEGRAM_WARNING_CHAT_ID=-100987654321

# AI saglayici zinciri, soldan saga denenir (default: agy,codex).
# Sadece Codex icin: AI_PROVIDERS=codex — sadece agy icin: AI_PROVIDERS=agy
# Hicbiri calismazsa kurali analiz kullanilir.
# AI_PROVIDERS=agy,codex

# agy CLI binary yolu (default: agy — PATH'de olmasi gerekir)
# AGY_BIN=/usr/local/bin/agy

# agy modeli (`agy models` ciktisindan). Default: gemini-3.8-flash-high
# AGY_MODEL=gemini-3.8-flash-high

# agy kota/model/yetki hatasindan sonra tekrar denemeden once beklenecek sure (dakika, default: 60)
# AGY_FAILURE_BACKOFF_MINUTES=60

# Codex CLI binary yolu (default: codex — PATH'de olmasi gerekir)
# CODEX_BIN=/usr/local/bin/codex

# ChatGPT ile giris yapan Codex CLI icin desteklenen model. Varsayilan:
# gpt-5.6-terra. Farkli bir desteklenen model kullanmak icin degistirin.
# CODEX_MODEL=gpt-5.6-terra

# Codex kota/model/yetki hatasindan sonra tekrar denemeden once beklenecek sure
# (dakika, default: 60). Hata net bir reset saati icerirse o saat kullanilir.
# CODEX_FAILURE_BACKOFF_MINUTES=60

# Ajan makinesinin salt-okunur kaynak uyarilari. Hicbir otomatik temizleme yapilmaz.
# AGENT_DISK_WARNING_PERCENT=85
# AGENT_DISK_CRITICAL_PERCENT=95
# AGENT_SWAP_WARNING_PERCENT=80

# SSH tanilamasi varsayilan olarak kapali. Acildiginda sadece whitelist'teki
# salt-okunur komutlar, monitor tag'lariyla eslesen hostlarda calistirilir.
# SSH_DIAGNOSTICS_ENABLED=false
# SSH_USER=ubuntu
# SSH_KEY_PATH=/home/ubuntu/.ssh/id_rsa
